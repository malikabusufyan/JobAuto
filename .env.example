# Anthropic (required) - used to tailor resumes/cover letters and parse your existing resume
ANTHROPIC_API_KEY=
# Optional override - defaults to claude-haiku-4-5 (cheap, well-suited to this task).
# Use claude-sonnet-5 or claude-opus-5 for higher-effort writing at higher cost.
CLAUDE_MODEL=

# USAJobs.gov (free, instant signup at https://developer.usajobs.gov/APIRequest/Index)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=you@example.com

# Adzuna (free tier, register at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Your identity, sent as a courteous User-Agent header on outbound requests
CONTACT_EMAIL=you@example.com

# Optional - reuse your real, already-signed-in Chrome profile for the apply/search
# browser instead of a blank one. Fixes Google/Microsoft's "this browser or app may not
# be secure" block on sign-in, since no new OAuth handshake ever happens. Find these two
# values via chrome://version -> "Profile Path" in your regular Chrome (e.g.
# "C:\Users\you\AppData\Local\Google\Chrome\User Data\Profile 1" splits into the two
# fields below). Your regular Chrome must be fully closed before JobAuto opens a browser.
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIRECTORY=Default

# Optional, and takes priority over the two settings above: attach to a Chrome window
# that's already running instead of launching a separate one, so you never have to close
# Chrome for JobAuto. Run scripts/launch-chrome-debug.ps1 once (from a fully-closed Chrome)
# to start it with this port open, then set the same port number here. Leave both this and
# CHROME_USER_DATA_DIR unset to use the tool's own isolated browser profile instead.
CHROME_REMOTE_DEBUGGING_PORT=
