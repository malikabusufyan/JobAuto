# Anthropic (required) - used to tailor resumes/cover letters and parse your existing resume
ANTHROPIC_API_KEY=
# Optional override - defaults to claude-haiku-4-5 (cheap, well-suited to this task).
# Use claude-sonnet-5 or claude-opus-5 for higher-effort writing at higher cost.
CLAUDE_MODEL=

# USAJobs.gov (free, instant signup at https://developer.usajobs.gov/APIRequest/Index)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=you@example.com

# Adzuna (free tier, register at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Your identity, sent as a courteous User-Agent header on outbound requests
CONTACT_EMAIL=you@example.com
